# ==============================================================================
# PULSEGRID PRODUCTION DOCKER CLUSTER ENVIRONMENT CONFIGURATION
# Copy this file to docker/.env on your server and generate strong secrets.
# ==============================================================================

# Database Passwords (Must be strong, unique values)
POSTGRES_PASSWORD=replace-with-a-generated-strong-db-password
REPLICATION_PASSWORD=replace-with-a-different-strong-replication-password

# Authentication & Encryption Secrets
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-64-character-hex-secret
MONITOR_TARGET_ENCRYPTION_KEY=replace-with-64-character-hex-secret

# Comma-separated email addresses that receive administrator access
ADMIN_EMAILS=olusanyaemmanuelpg@gmail.com

# Security & Ingress CORS Allowlist (Comma-separated origins)
# Set this to your live production frontend domain(s)
CORS_ORIGIN=https://pulsegrid.yourdomain.com,https://yourdomain.com

# Multi-Channel Alert Credentials (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=